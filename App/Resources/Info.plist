<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Idlewild</string>
	<key>CFBundleExecutable</key>
	<string>Idlewild</string>
	<key>CFBundleIconFile</key>
	<string>Idlewild</string>
	<key>CFBundleIdentifier</key>
	<string>it.salamacchine.idlewild</string>
	<key>CFBundleName</key>
	<string>Idlewild</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2.1</string>
	<!-- Sparkle compares this, not the short version string, so it has to keep
	     increasing: major*10000 + minor*100 + patch. 1.2.0 is 10200. -->
	<key>CFBundleVersion</key>
	<string>10201</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Updates, via Sparkle. See App/Support/Updater.swift.

	     SUPublicEDKey is the trust anchor: the appcast is only a hint, and an
	     update installs only if it carries an Ed25519 signature made with the
	     matching private key (which lives in the release job's secrets and in
	     the maintainer's keychain) and is signed by the same team as the app
	     already running. The feed being compromised is therefore not enough.

	     SUEnableAutomaticChecks: check daily without asking permission first,
	     which is what this app did before Sparkle. SUVerifyUpdateBeforeExtraction
	     makes Sparkle check the signature before it unpacks the disk image,
	     rather than after. -->
	<key>SUFeedURL</key>
	<string>https://www.salamacchine.it/apps/idlewild/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>iAuElTvpHub/5F8g7x6jknJeMvAWl73d7OnvUKcocvM=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
