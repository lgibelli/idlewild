# release.env.example — signing configuration for the Idlewild release scripts.
#
# Copy this file to release.env (which is gitignored) and fill in your own
# values, OR export these variables in your shell before running the scripts.
# The release scripts source release.env automatically if present.
#
#   cp release.env.example release.env
#   $EDITOR release.env
#
# These are intentionally NOT committed so the repo carries no account-specific
# identifiers.

# Your Apple Developer Team ID (10 chars, e.g. ABCDE12345). Find it at
# https://developer.apple.com/account → Membership details.
TEAM_ID="YOURTEAMID"

# notarytool keychain profile name. Create one once with:
#   xcrun notarytool store-credentials "idlewild-notary" \
#     --apple-id "you@example.com" \
#     --team-id  "$TEAM_ID" \
#     --password "<app-specific-password>"
#
# An existing account-wide profile from another project works fine here.
NOTARY_PROFILE="idlewild-notary"
